# Environment Configuration
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Backend Engine API"
API_V1_STR="/api/v1"

# Database Configuration
# PostgreSQL default async connection string: postgresql+asyncpg://user:password@localhost:5432/backend_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/backend_engine_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT Security
# Generate secure random secret with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (JSON array or comma-separated list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Logging
LOG_LEVEL=INFO
